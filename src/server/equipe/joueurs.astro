---
// Joueurs : chacun relie ses comptes de jeu ; le roster voit les profils (op.gg, tracker.gg, osu!) et les rangs quand une clé d'API est configurée.
import Qg from './Qg.astro';
import { canLead, rosterMembers, scope, teamUser } from './outils';
import { rows } from '../db';
import { REGIONS, TIERS_FR, links, lolRank, osuStats } from './stats';

export const prerender = false;
const t = await teamUser(Astro.cookies);
if (!t) return Astro.redirect('/equipe/');
const { user, me } = t;

type Acc = { user_id: string; game: string; ident: string; region: string | null };
type St = { user_id: string; statut: string; essai_fin: number | null; retour: string | null };
const dayFmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', timeZone: 'Europe/Paris' });
const isoDay = (ms: number | null) => (ms ? new Date(Number(ms)).toLocaleDateString('sv-SE', { timeZone: 'Europe/Paris' }) : '');
// Ordre d'affichage : titulaires, remplaçants, puis joueurs en essai
const RANK: Record<string, number> = { titulaire: 0, remplacant: 1, essai: 2 };
const mine = await rows<Acc>('SELECT * FROM accounts WHERE user_id = ?', user.id);
const get = (g: string) => mine.find((a) => a.game === g);
// Smurfs (20/10) : comptes secondaires Riot et Rocket League, relevés par Oni Bot au nom du joueur
const alts = await rows<Acc>('SELECT * FROM accounts_alt ORDER BY updated_at').catch(() => [] as Acc[]);
const myAlts = alts.filter((a) => a.user_id === user.id);

const POSTE_ICON: Record<string, string> = { Top: 'lol-top', Jungle: 'lol-jungle', Mid: 'lol-mid', ADC: 'lol-adc', Support: 'lol-support', Duelliste: 'valo-duelliste', Initiateur: 'valo-initiateur', 'Contrôleur': 'valo-controleur', Sentinelle: 'valo-sentinelle' };
const GAME_LABEL: Record<string, string> = { rl: 'Rocket League', lol: 'League of Legends', valo: 'Valorant', osu: 'osu!' };
const sc = scope(me.rosters, Astro.url, Astro.cookies);
const rosters = await Promise.all(sc.list.map(async (r) => {
  const members = await rosterMembers(r.role_id);
  const postes = new Map<string, string>((await rows<{ user_id: string; poste: string }>('SELECT user_id, poste FROM roster_postes WHERE roster_id = ?', r.id).catch(() => [])).map((x) => [String(x.user_id), x.poste] as [string, string]));
  const statuts = new Map((await rows<St>('SELECT user_id, statut, essai_fin, retour FROM roster_status WHERE roster_id = ?', r.id).catch(() => [] as St[])).map((x) => [String(x.user_id), x]));
  const accs = members.length ? await rows<Acc>(`SELECT * FROM accounts WHERE user_id IN (${members.map(() => '?').join(',')})`, ...members.map((m) => m.id)) : [];
  const people = await Promise.all(members.map(async (m) => {
    const a = (g: string) => accs.find((x) => x.user_id === m.id && x.game === g);
    const riot = a('riot'), rl = a('rl'), osu = a('osu');
    return {
      ...m, riot, rl, osu, poste: postes.get(m.id) ?? null, st: statuts.get(m.id) ?? null,
      lol: riot && r.game === 'lol' ? await lolRank(riot.ident, riot.region ?? 'euw') : null,
      osuS: osu && r.game === 'osu' ? await osuStats(osu.ident) : null,
    };
  }));
  const riotIds = people.map((p) => p.riot?.ident).filter((x): x is string => !!x);
  const [link] = r.game === 'lol' ? await rows<{ url: string }>(`SELECT url FROM roster_links WHERE roster_id = ? AND kind = 'opgg'`, r.id).catch(() => []) : [];
  return { r, people, multi: link?.url ?? (riotIds.length ? links.opggMulti(riotIds, people.find((p) => p.riot)?.riot?.region ?? 'euw') : null) };
}));
const games = [...new Set(me.rosters.map((r) => r.game))];
// Les rangs viennent d'Oni Bot : on regarde s'il en a déjà déposé
const seen = await rows<{ key: string }>(`SELECT key FROM stats_cache WHERE key LIKE 'lol:%' OR key LIKE 'osu:%' LIMIT 50`);
const keys = { riot: !!process.env.RIOT_API_KEY || seen.some((k) => k.key.startsWith('lol:')), osu: !!process.env.OSU_CLIENT_ID || seen.some((k) => k.key.startsWith('osu:')) };
// Jeu mis en avant (lien du parcours d'arrivée) : lol et valo partagent le Riot ID
const jeuParam = Astro.url.searchParams.get('jeu');
const focus = jeuParam === 'lol' || jeuParam === 'valo' ? 'riot' : jeuParam === 'rl' || jeuParam === 'osu' ? jeuParam : null;
---
<Qg title="Joueurs · Inside" heading="Joueurs" lead="Relie tes comptes : ton roster voit tes profils et ton rang, sans rien demander." current="joueurs" rosters={me.rosters} staff={me.staff || me.games.length > 0} contenu={me.staff || me.content.length > 0} communaute={me.community} active={sc.active} user={{ name: t.me.member?.name ?? t.user.name, avatar: t.me.member?.avatar ?? t.user.avatar }}>
  {true && (
    <details class="qg-drawer" slot="actions" open={!!focus}>
      <summary class="btn btn--ghost">Relier mes comptes</summary>
      <div class="qg-drawer__panel" role="dialog" aria-label="Mes comptes de jeu">
        <div class="qg-drawer__head"><h2>Mes comptes de jeu</h2><button type="button" class="qg-close" aria-label="Fermer" onclick="this.closest('details').open = false">×</button></div>
      <form method="post" action="/api/equipe/outils" class="jo-me">
        <input type="hidden" name="action" value="comptes" /><input type="hidden" name="back" value={`/equipe/joueurs/${sc.active ? `?r=${sc.active}` : ''}`} />
        
        {/* Arrivée depuis le parcours d'une recrue (?jeu=…) : son jeu d'abord, les autres repliés et facultatifs.
            Tous les champs restent dans le formulaire : rien n'est effacé en enregistrant. */}
        <div class="jo-fields">
          {(!focus || focus === 'riot') && <>
            <label>Riot ID <small>(LoL et Valorant)</small><input name="riot" value={get('riot')?.ident ?? ''} placeholder="Pseudo#TAG" maxlength="60" pattern=".+#.+" /></label>
            <label>Région<select name="region">{Object.entries(REGIONS).map(([k, v]) => <option value={k} selected={(get('riot')?.region ?? 'euw') === k}>{v.label}</option>)}</select></label>
          </>}
          {(!focus || focus === 'rl') && <label>Rocket League <small>(pseudo Epic)</small><input name="rl" value={get('rl')?.ident ?? ''} maxlength="60" /></label>}
          {(!focus || focus === 'osu') && <label>osu! <small>(pseudo)</small><input name="osu" value={get('osu')?.ident ?? ''} maxlength="60" /></label>}
        </div>
        {focus && (
          <details class="jo-more">
            <summary>Autres jeux (facultatif)</summary>
            <div class="jo-fields">
              {focus !== 'riot' && <>
                <label>Riot ID <small>(LoL et Valorant)</small><input name="riot" value={get('riot')?.ident ?? ''} placeholder="Pseudo#TAG" maxlength="60" pattern=".+#.+" /></label>
                <label>Région<select name="region">{Object.entries(REGIONS).map(([k, v]) => <option value={k} selected={(get('riot')?.region ?? 'euw') === k}>{v.label}</option>)}</select></label>
              </>}
              {focus !== 'rl' && <label>Rocket League <small>(pseudo Epic)</small><input name="rl" value={get('rl')?.ident ?? ''} maxlength="60" /></label>}
              {focus !== 'osu' && <label>osu! <small>(pseudo)</small><input name="osu" value={get('osu')?.ident ?? ''} maxlength="60" /></label>}
            </div>
          </details>
        )}
        <button class="btn">Enregistrer</button>
      </form>
      <section class="jo-alts" aria-labelledby="jo-alts-title">
        <h3 id="jo-alts-title">Smurfs <small>(comptes secondaires, 6 au plus)</small></h3>
        <p class="eq-note">Leurs parties comptent dans tes stats, le drafter et les débriefs. Ton rang affiché reste celui du compte principal. Pas pour osu!, qui interdit le multi-compte.</p>
        {myAlts.length > 0 && <ul>{myAlts.map((a) => (
          <li><span>{a.game === 'riot' ? 'Riot' : 'Rocket League'} · <strong>{a.ident}</strong>{a.region && a.game === 'riot' ? ` (${REGIONS[a.region]?.label ?? a.region})` : ''}</span>
            <form method="post" action="/api/equipe/outils"><input type="hidden" name="action" value="compte-alt" /><input type="hidden" name="retirer" value="1" /><input type="hidden" name="game" value={a.game} /><input type="hidden" name="ident" value={a.ident} /><input type="hidden" name="back" value={`/equipe/joueurs/${sc.active ? `?r=${sc.active}` : ''}`} /><button class="jo-x" aria-label={`Retirer ${a.ident}`}>Retirer</button></form></li>
        ))}</ul>}
        {myAlts.length < 6 && (
          <form method="post" action="/api/equipe/outils" class="jo-alts__add">
            <input type="hidden" name="action" value="compte-alt" /><input type="hidden" name="back" value={`/equipe/joueurs/${sc.active ? `?r=${sc.active}` : ''}`} />
            <label>Jeu<select name="game"><option value="riot">Riot (LoL, Valorant)</option><option value="rl">Rocket League</option></select></label>
            <label>Pseudo<input name="ident" required maxlength="60" placeholder="Pseudo#TAG ou pseudo Epic" /></label>
            <label>Région<select name="region">{Object.entries(REGIONS).map(([k, v]) => <option value={k}>{v.label}</option>)}</select></label>
            <button class="btn btn--ghost">Ajouter</button>
          </form>
        )}
      </section>
      </div>
    </details>
  )}
    <div class="jo">
      {!mine.length && <p class="qg-empty"><strong>Relie tes comptes de jeu</strong>Tes rangs et tes parties apparaîtront dans Stats et sur ton profil. Bouton « Relier mes comptes », en haut à droite.</p>}


      {rosters.map(({ r, people, multi }) => (
        <article class="jo-roster">
          <div class="jo-roster__head">
            <h2 class="jo-h">{r.name} <span>{GAME_LABEL[r.game] ?? r.game}</span></h2>
            {multi && r.game === 'lol' && <a class="btn btn--ghost" href={multi} rel="noopener">op.gg du roster</a>}
          </div>
          {people.length ? (
            <ul class="jo-list">
              {[...people].sort((a, b) => (RANK[a.st?.statut ?? 'titulaire'] ?? 0) - (RANK[b.st?.statut ?? 'titulaire'] ?? 0)).map((p) => (
                <li>
                  <a class="jo-who" href={`/equipe/profil/?u=${p.id}`}>{p.avatar ? <img src={p.avatar} alt="" width="44" height="44" loading="lazy" crossorigin="anonymous" referrerpolicy="no-referrer" /> : <span class="jo-ini" aria-hidden="true">{p.name.slice(0, 1)}</span>}<span><strong>{p.name}{p.st && p.st.statut !== 'titulaire' && <em class:list={['jo-badge', { 'is-essai': p.st.statut === 'essai' }]}>{p.st.statut === 'essai' ? `En essai${p.st.essai_fin ? ` · jusqu'au ${dayFmt.format(new Date(Number(p.st.essai_fin)))}` : ''}` : 'Remplaçant'}</em>}</strong><small>{p.poste && POSTE_ICON[p.poste] && <img class="jo-poste" src={`/img/postes/${POSTE_ICON[p.poste]}.webp`} alt="" width="16" height="16" />}{p.poste ?? 'Poste à définir'}</small></span></a>
                  <span class="jo-stat">
                    {p.lol && p.lol.tier !== 'UNRANKED' && <img class="jo-emblem" src={`/img/rangs/lol/${p.lol.tier.toLowerCase()}.webp`} alt="" width="32" height="32" loading="lazy" />}
                    {p.lol && (p.lol.tier === 'UNRANKED' ? 'Non classé' : `${TIERS_FR[p.lol.tier] ?? p.lol.tier} ${['MASTER', 'GRANDMASTER', 'CHALLENGER'].includes(p.lol.tier) ? '' : p.lol.rank} · ${p.lol.lp} LP · ${p.lol.wins}V ${p.lol.losses}D`)}
                    {p.osuS && `#${p.osuS.rank?.toLocaleString('fr-FR') ?? '—'} · ${p.osuS.pp} pp · ${p.osuS.acc} %`}
                  </span>
                  <span class="jo-links">
                    {/* Seulement les profils du jeu de ce roster */}
                    {r.game === 'lol' && p.riot && <a href={links.opgg(p.riot.ident, p.riot.region ?? 'euw')} rel="noopener">op.gg</a>}
                    {(r.game === 'lol' || r.game === 'valo') && alts.filter((a) => a.user_id === p.id && a.game === 'riot').map((a) => <a href={r.game === 'lol' ? links.opgg(a.ident, a.region ?? 'euw') : links.valo(a.ident)} rel="noopener" title={`Smurf : ${a.ident}`}>smurf</a>)}
                    {r.game === 'rl' && alts.filter((a) => a.user_id === p.id && a.game === 'rl').map((a) => <a href={links.rl(a.ident)} rel="noopener" title={`Smurf : ${a.ident}`}>smurf</a>)}
                    {r.game === 'valo' && p.riot && <a href={links.valo(p.riot.ident)} rel="noopener">tracker</a>}
                    {r.game === 'rl' && p.rl && <a href={links.rl(p.rl.ident)} rel="noopener">tracker</a>}
                    {r.game === 'osu' && p.osu && <a href={links.osu(p.osu.ident)} rel="noopener">osu!</a>}
                    {r.game === 'osu' && p.osu && <a href={links.osutrack(p.osu.ident)} rel="noopener">osu!track</a>}
                    {!({ lol: p.riot, valo: p.riot, rl: p.rl, osu: p.osu } as Record<string, unknown>)[r.game] && <em>compte {GAME_LABEL[r.game] ?? ''} pas encore relié</em>}
                  </span>
                  {canLead(me, r.id) && (
                    <details class="jo-statut">
                      <summary>Statut</summary>
                      <form method="post" action="/api/equipe/outils">
                        <input type="hidden" name="action" value="statut" /><input type="hidden" name="roster" value={r.id} /><input type="hidden" name="user" value={p.id} /><input type="hidden" name="back" value={`/equipe/joueurs/${sc.active ? `?r=${sc.active}` : ''}`} />
                        <label>Statut<select name="statut">{[['titulaire', 'Titulaire'], ['remplacant', 'Remplaçant'], ['essai', 'En essai']].map(([v, l]) => <option value={v} selected={(p.st?.statut ?? 'titulaire') === v}>{l}</option>)}</select></label>
                        <label>Fin de l'essai<input type="date" name="fin" value={isoDay(p.st?.essai_fin ?? null)} /></label>
                        <label class="jo-retour">Retour à la fin de l'essai<textarea name="retour" rows="2" maxlength="1000" placeholder="Ce qui a convaincu, ce qui manque, la suite">{p.st?.retour ?? ''}</textarea></label>
                        <button class="btn btn--ghost">Enregistrer</button>
                      </form>
                    </details>
                  )}
                </li>
              ))}
            </ul>
          ) : <p class="eq-note">Personne dans ce roster pour l'instant.</p>}
        </article>
      ))}
      {!me.rosters.length && <p class="eq-note">Aucun roster pour l'instant : ils apparaîtront ici dès leur création sur Discord (<code>/roster creer</code>).</p>}
      {me.staff && (!keys.riot || !keys.osu) && (
        <p class="eq-note jo-keys">Encadrement : les rangs s'affichent automatiquement avec {!keys.riot && <>une clé <a href="https://developer.riotgames.com" rel="noopener">Riot</a> (RIOT_API_KEY)</>}{!keys.riot && !keys.osu && ' et '}{!keys.osu && <>une application <a href="https://osu.ppy.sh/home/account/edit#oauth" rel="noopener">osu!</a> (OSU_CLIENT_ID, OSU_CLIENT_SECRET)</>} dans le fichier <code>.env</code> d'Oni Bot. Sans elles, les liens de profil suffisent.</p>
      )}
    </div>
</Qg>

<style>
  .eq-mini { padding-block: 2.5rem 1.5rem; }
  .eq-mini h1 { font-size: clamp(2rem, 6vw, 3.5rem); }
  .jo { display: grid; gap: 3rem; }
  .jo-h { font-family: var(--font-body); font-weight: 700; font-size: 1.05rem; display: flex; gap: .75rem; align-items: baseline; }
  .jo-h span { color: var(--muted); font-weight: 400; font-size: var(--step--1); }
  .jo-me { display: grid; gap: 1rem; padding: 1.25rem; border: 1px solid var(--line); max-width: 56rem; }
  .jo-fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: 1rem; }
  .jo-fields label { display: grid; gap: .35rem; font-weight: 700; font-size: .9rem; }
  .jo-fields small { font-weight: 400; color: var(--muted); }
  .jo-fields :is(input, select) { width: 100%; box-sizing: border-box; min-height: 44px; padding: .5rem .7rem; border: 1px solid var(--line); background: var(--paper); color: var(--ink); font: 400 1rem var(--font-body); }
  .jo-me .btn { justify-self: start; }
  .jo-roster__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding-bottom: .6rem; border-bottom: 2px solid var(--ink); }
  .jo-list li { display: grid; grid-template-columns: minmax(12rem, 1fr) minmax(10rem, 1.2fr) auto; gap: .5rem 1.5rem; align-items: center; padding: .9rem 0; border-bottom: 1px solid var(--line); transition: background-color .15s; }
  .jo-list li:hover { background: var(--qg-surface, transparent); }
  .jo-who > span { display: grid; gap: .1rem; }
  .jo-who small { display: flex; align-items: center; gap: .3rem; color: var(--muted); font-size: .85rem; }
  .jo-poste { width: 16px; height: 16px; background: #141210; border-radius: 3px; padding: 1px; }
  .jo-ini { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--line); font-weight: 700; }
  .jo-stat { display: flex; align-items: center; gap: .6rem; }
  .jo-emblem { width: 32px; height: 32px; object-fit: contain; flex: none; }
  .jo-who { display: flex; align-items: center; gap: .6rem; }
  .jo-badge { margin-left: .45rem; padding: .05rem .4rem; border: 1px solid var(--line); font: 600 .7rem var(--font-body); font-style: normal; color: var(--muted); vertical-align: middle; }
  .jo-badge.is-essai { border-color: #f0a04b; color: #f0a04b; }
  .jo-statut { grid-column: 1 / -1; font-size: .85rem; }
  .jo-statut summary { width: fit-content; color: var(--muted); cursor: pointer; }
  .jo-statut summary:hover { color: var(--ink); }
  .jo-statut form { display: flex; flex-wrap: wrap; align-items: end; gap: .6rem 1rem; margin-top: .5rem; }
  .jo-statut label { display: grid; gap: .2rem; font-weight: 700; font-size: .8rem; }
  .jo-statut :is(select, input, textarea) { padding: .35rem .5rem; border: 1px solid var(--line); background: var(--paper); color: var(--ink); font: 400 .85rem var(--font-body); }
  .jo-retour { flex: 1 1 18rem; } .jo-retour textarea { width: 100%; box-sizing: border-box; }
  .jo-who { color: inherit; text-decoration: none; } .jo-who:hover strong { text-decoration: underline; }
  .jo-who img { border-radius: 50%; background: var(--line); }
  .jo-stat { color: var(--ink); font-size: .92rem; }
  .jo-links { display: flex; flex-wrap: wrap; gap: .4rem .9rem; justify-content: flex-end; font-size: .9rem; }
  .jo-links a { font: 500 .8rem/1.3 var(--qg-mono, monospace); color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--line); }
  .jo-links a:hover { color: var(--ink); border-bottom-color: var(--ink); }
  .jo-links em { color: var(--muted); font-size: var(--step--1); }
  .jo-keys { max-width: 60ch; }
  .eq-note { color: var(--muted); font-size: var(--step--1); }
  @media (max-width: 640px) { .jo-list li { grid-template-columns: 1fr; } .jo-links { justify-content: flex-start; } }
  .jo-more { margin: .75rem 0 1rem; }
  .jo-alts { display: grid; gap: .6rem; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); max-width: 56rem; }
  .jo-alts h3 { font-family: var(--font-body); font-size: 1rem; font-weight: 700; margin: 0; }
  .jo-alts h3 small { font-weight: 400; color: var(--muted); }
  .jo-alts ul { display: grid; gap: .3rem; margin: 0; padding: 0; list-style: none; }
  .jo-alts li { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .35rem 0; border-bottom: 1px solid var(--line); font-size: .9rem; }
  .jo-x { min-height: 32px; padding: 0 .6rem; border: 1px solid var(--line); background: none; color: var(--muted); font: 600 .78rem var(--font-body); cursor: pointer; }
  .jo-x:hover { color: var(--ink); border-color: var(--ink); }
  .jo-alts__add { display: flex; flex-wrap: wrap; align-items: end; gap: .6rem; }
  .jo-alts__add label { display: grid; gap: .25rem; font-weight: 700; font-size: .85rem; }
  .jo-alts__add :is(input, select) { min-height: 40px; padding: .4rem .6rem; border: 1px solid var(--line); background: var(--paper); color: var(--ink); font: 400 .95rem var(--font-body); }
  .jo-more summary { cursor: pointer; color: var(--muted); font-weight: 700; }
</style>
